* {
    // Global Settings

    // Color Variables
    grey:  #eeeeee;
    jblack: #06090f;
    jnavy1: #1b2d48;
    jnavy2: #203656;
    jnavy3: #305181; 
    jblue: #305181;
    jgrey: #9E9A99;
    jbluegrey1: #949BA6;
    jbluegrey2: #C6CEDB;
    jceleste: #E4EAf4; 
    jgreen: #c9e7dd; 
    jcoral: #ef6362;      

    // Overall Window Properties
    spacing: 2;  // Space between inputbar and list
    background-color: #00000000; // Sets overall window to transparent
    border-color: @jnavy1; // Border color for inputbar/list boxes
    text-color: @jceleste;
    anchor: center;
    location: center;
}

#window {
    // No idea what this section controls
    transparency: "screenshot";
    width: 40%;
    background-color: #00000000;
    border: 0;
    padding: 0% 0% 1em 0%;
    x-offset: 0;
    y-offset: 0;
}

#mainbox {
    // Spacing option controls space between inputbar and list
    padding: 0px;
    border: 0;
    spacing: 1%;
}

#message {
    // No idea what this section controls
    border: 2px; 
    padding: 1em; 
    background-color: @jceleste; 
    text-color: @jblack;
}

#textbox normal {
    // No idea what this section controls
    text-color: #002B36FF;
    padding: 0;
    border: 0;
}

#listview {
    // Properties of the results list box
    fixed-height: 1;
    border: 2px;
    padding: 1em;
    reverse: false;
    columns: 1;
    lines: 8;
    background-color: @jnavy1; //BG color for entire list box
}

#element {
    // No idea what this section controls
    border: 0;
    padding: 2px;
    highlight: bold ;
}

element-icon {
    size:             1.1em ;
}

#element normal.normal {
    // Properties of odd rows in list box
    text-color: @jceleste;
    background-color: @jnavy1;
}

#element normal.urgent {
    // No idea what this section controls
    text-color: #D75F00FF;
    background-color: #F5F5F5FF;
}

#element normal.active {
    // No idea what this section controls
    text-color: #005F87FF;
    background-color: #F5F5F5FF;
}

#element selected.normal {
    //Properties for currently selected item in list box
    text-color: @jblack;
    background-color: @jcoral;
}

#element selected.urgent {
    // No idea what this section controls
    text-color: #F5F5F5FF;
    background-color: #D75F00FF;
}

#element selected.active {
    text-color: #F5F5F5FF;
    background-color: #005F87FF;
}

#element alternate.normal {
    // Properties of even rows in list box
    text-color: @jceleste;
    background-color: @jnavy2;
}

#element alternate.urgent {
    // No idea what this section controls
    text-color: #D75F00FF;
    background-color: #D0D0D0FF;
}

#element alternate.active {
    // No idea what this section controls
    text-color: #005F87FF;
    background-color: #D0D0D0FF;
}

#scrollbar {
    // Properties of the scroll, if enabled
    border: 0;
    padding: 0;
}

#inputbar {
    // Properties of the inputbar at the top
    spacing: 0;
    border: 2px;
    padding: 0.5em 1em;
    background-color: @jnavy3;
    // Can't set text color here. Go to global section {* } above.
    index: 0;
}

#inputbar normal {
    // No idea what this section controls
    foreground-color: #002B36FF;
    background-color: #F5F5F500;
}


#sidebar {
    // Properties of the sidebar, if enabled
    border: 2px;
    padding: 0.5em 1em;
    background-color: @jceleste;
    index: 10;
}

#button selected {
    // No idea what this section controls
    text-color: #4271AEFF;
}
